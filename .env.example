# Optional development overrides. For normal setup, run switchboard init.
# Coding agents keep their existing logins; these keys are for Jev classification.
SWITCHBOARD_PROVIDER=typesafe
TYPESAFE_API_KEY=
# Omit to follow jev-latest; this pin is a TypeSafe model ID.
TYPESAFE_DEFAULT_MODEL=jev-1.13.0

# Alternative presets (choose one provider):
# SWITCHBOARD_PROVIDER=vercel
# AI_GATEWAY_API_KEY=
# SWITCHBOARD_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# Advanced overrides for a matching API contract:
# SWITCHBOARD_BASE_URL=
# SWITCHBOARD_MODEL=
# SWITCHBOARD_API_KEY=
